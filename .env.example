# ==============================================================================
# DevFest Stuttgart 2026 — From Agents to Evolution
# Attendee & Speaker Environment Template (.env.example)
# Copy this file to `.env` (root) or `web/.env` and fill in your credentials.
# All demos include a zero-credential OFFLINE / PRERECORDED mode out of the box!
# ==============================================================================

# 1. Execution Mode ("prerecorded" for offline/attendee replay, "live" for GCP APIs)
DEMO_EXECUTION_MODE=prerecorded

# 2. Gemini API & Official AlphaEvolve Ensemble Models (Optional: live mutation)
# Obtain an API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_FAST_MODEL=gemini-3.5-flash
GEMINI_REASONING_MODEL=gemini-3.1-pro-preview

# 3. Google Cloud & Gemini Enterprise AlphaEvolve (`ae` CLI & Discovery Engine API)
# Codelab: https://codelabs.developers.google.com/alphaevolve-on-google-cloud-1#0
# Repo:    https://github.com/Google-Cloud-AI/alphaevolve-on-googlecloud
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=global
GE_COLLECTION_ID=default_collection
GE_ENGINE_ID=your-gemini-enterprise-engine-id
GE_ASSISTANT_ID=default_assistant
DISCOVERY_ENGINE_API_URL=https://discoveryengine.googleapis.com/v1alpha

# 4. Antigravity 2.0 SDK Configuration (`uv add google-antigravity`)
# Docs: https://antigravity.google/docs & https://github.com/google-antigravity/antigravity-sdk-python
AGY_SANDBOX_MODE=proceed-in-sandbox
AGY_MAX_PARALLEL_SUBAGENTS=3

# 5. Zero-Leak Ephemeral Spot Cloud TPU Target (`scripts/run_alphaevolve_spot_tpu.sh`)
GCP_TPU_NAME=alphaevolve-tpu
GCP_TPU_ZONE=europe-west4-a
GCP_TPU_TYPE=v6e-1
GCP_TPU_VERSION=v2-alpha-tpuv6e
TORCH_TPU_DEVICE=tpu:0
