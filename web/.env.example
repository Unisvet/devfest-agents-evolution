# ==============================================================================
# Web Presentation & Live Demo Bridge (.env.example)
# Copy to `web/.env` only if enabling live browser-side Gemini / GCP experiments.
# By default, the deck runs in zero-credential PRERECORDED mode!
# ==============================================================================

VITE_DEFAULT_DEMO_MODE=prerecorded
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-3.8-flash
VITE_GCP_PROJECT_ID=
VITE_GITHUB_REPO_URL=https://github.com/Unisvet/devfest-agents-evolution
